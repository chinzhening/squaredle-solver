# Copy to .env and adjust. Every value below is optional — the defaults shown
# are what config.py falls back to when the key is absent.
# Real environment variables take precedence over this file.

# --- Puzzle source ---------------------------------------------------------
# Solve the XP board instead of the daily board.
USE_XP=false

# Only override these if squaredle.app moves.
# URL_NORMAL=https://www.squaredle.app/
# URL_XP=https://www.squaredle.app/?level=xp

# --- Solver ----------------------------------------------------------------
# Path to the binary built from cpp/. Defaults to <repo>/cpp/build/main.exe;
# set this if you build elsewhere or run on a non-Windows platform.
# SOLVER_PATH=/path/to/repo/cpp/build/main

# --- Result writers --------------------------------------------------------
# Human-readable summary to stdout (also captured by CI logs).
ENABLE_STDOUT_WRITER=true

# Persist full results to MongoDB. Requires MONGO_URI when true.
ENABLE_MONGO_WRITER=false
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=squaredle
MONGO_COLLECTION=results
